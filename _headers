# Cloudflare Pages — HTTP headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Force HTTPS ( belt-and-braces; Pages does this anyway )
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Sensible security baseline
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Long-cache the static assets (they're fingerprintable later if needed)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
