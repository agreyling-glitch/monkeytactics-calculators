# Cloudflare Pages — HTTP headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Force HTTPS ( belt-and-braces; Pages does this anyway )
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Sensible security baseline
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # Camera remains origin-restricted and still requires browser permission.
  # It is used by the client-side QR decoder.
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)

# Long-cache the static assets (they're fingerprintable later if needed)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/shared/style.css
  Cache-Control: no-cache

/assets/wasm/menu/menu_bg.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache

/assets/wasm/menu/menu.js
  Content-Type: application/javascript
  Cache-Control: no-cache

/assets/wasm/menu/menu.css
  Content-Type: text/css
  Cache-Control: no-cache
